{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/Agent-Execution-Conformance-Infrastructure/contracts/conformance-report.schema.json",
  "title": "Agent-device-effect conformance report",
  "type": "object",
  "required": ["profile", "passed", "results"],
  "properties": {
    "profile": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed", "states", "codes", "observedState"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "states": { "type": "array", "items": { "type": "string" } },
          "codes": { "type": "array", "items": { "type": "string" } },
          "observedState": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
