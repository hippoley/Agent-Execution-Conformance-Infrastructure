{
  "profile": "agent-device-effect/0.1",
  "vectors": [
    {
      "id": "valid-command",
      "fixture": "valid",
      "now": 1020,
      "expected": {
        "state": "succeeded",
        "code": "POSTCONDITION_VERIFIED"
      },
      "expectedState": {
        "lampOn": true
      }
    },
    {
      "id": "expired-command",
      "fixture": "expired",
      "now": 1060,
      "expected": {
        "state": "expired",
        "code": "COMMAND_EXPIRED"
      },
      "expectedState": {
        "lampOn": false
      }
    },
    {
      "id": "tenant-mismatch",
      "fixture": "valid",
      "now": 1020,
      "principal": {
        "tenantId": "other"
      },
      "expected": {
        "state": "denied",
        "code": "IDENTITY_MISMATCH"
      },
      "expectedState": {
        "lampOn": false
      }
    },
    {
      "id": "capability-denied",
      "fixture": "valid",
      "now": 1020,
      "principal": {
        "capabilities": []
      },
      "expected": {
        "state": "denied",
        "code": "CAPABILITY_NOT_ALLOWED"
      },
      "expectedState": {
        "lampOn": false
      }
    },
    {
      "id": "postcondition-unavailable",
      "fixture": "valid",
      "now": 1020,
      "options": {
        "failReadback": true
      },
      "expected": {
        "state": "unverified",
        "code": "POSTCONDITION_UNAVAILABLE"
      },
      "expectedState": {
        "lampOn": true
      }
    },
    {
      "id": "duplicate-delivery",
      "fixture": "valid",
      "now": 1020,
      "repeat": 2,
      "expectedStates": [
        "succeeded",
        "duplicate"
      ],
      "expectedState": {
        "lampOn": true
      }
    },
    {
      "id": "idempotency-payload-conflict",
      "fixture": "valid",
      "now": 1020,
      "mutateSecond": {
        "arguments": {
          "on": false
        }
      },
      "expectedStates": [
        "succeeded",
        "denied"
      ],
      "expectedSecondCode": "IDEMPOTENCY_KEY_REUSE",
      "expectedState": {
        "lampOn": true
      }
    },
    {
      "id": "allowlisted-unsupported-capability",
      "fixture": "unsupported",
      "now": 1020,
      "principal": {
        "capabilities": [
          "lamp.set_power",
          "lock.unlock"
        ]
      },
      "expected": {
        "state": "denied",
        "code": "UNSUPPORTED_CAPABILITY"
      },
      "expectedState": {
        "lampOn": false
      }
    },
    {
      "id": "reject-extra-arguments",
      "fixture": "extra-arguments",
      "now": 1020,
      "expected": {
        "state": "denied",
        "code": "INVALID_ARGUMENTS"
      },
      "expectedState": {
        "lampOn": false
      }
    }
  ]
}
